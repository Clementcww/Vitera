__pycache__/
*.py[cod]
.venv/
venv/
.env

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

.DS_Store
.idea/
.vscode/

# Generated data is reproducible from a seed; do not commit it.
data/generated/*
!data/generated/.gitkeep
!data/generated/MANIFEST.json

# The LLM cache IS committed — demo-offline depends on it.
!data/generated/llm_cache/

# So is the OCR cache, for the same reason: `make intake` replays a recorded
# read of the committed sample scan in data/intake/, so a judge with no OCR
# engine still gets the corrected draft.
!data/generated/ocr_cache/

# Model weights go to HuggingFace, not to git. `models/` is the local
# checkpoint directory `make train` writes; calibration.json is copied into
# results/ so the numbers survive without the weights.
#
# Leading slash matters: a bare `models/` also matches src/vitera/models/,
# which would silently drop the entire model source package from the repo.
/models/
*.pt
*.safetensors
*.bin

# results/ IS committed: every paper figure and metrics JSON lives there.
# Its intake working directories are not — page rasters and degraded scans are
# regenerated on demand, and the sample scan that must survive lives in
# data/intake/ instead.
results/intake/.pages/
results/intake/.scanned/
results/intake/.eval/

# Workbench UI build artifacts. `make ui-install && make ui-build` regenerates
# both. The committed fallback if the toolchain is unavailable on the day is
# docs/ui/workbench-mockup.html, which needs no build step at all.
src/vitera/ui/node_modules/
src/vitera/ui/dist/
src/vitera/ui/tsconfig.tsbuildinfo

# Design reference video, kept locally for implementation. Not project material.
design-ref.mp4

# Internal planning docs for the coding agent: instructions, decision log,
# criteria tracker. Not part of the shipped project, kept local only.
CLAUDE.md
CRITERIA_PROGRESS.md
intent-anchor.md
.claude/
src/vitera/ui/.ssr-out/
