# Thresholds live in config.yaml, not here. This file is for secrets and
# deployment-specific paths only.

# Narrator + OCR fallback. The narrator writes prose over findings that already
# exist; it never produces a finding, and it never sees unredacted text.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# A PDF page whose text layer yields fewer characters than this is treated as
# scanned and routed to OCR.
OCR_MIN_CHARS_PER_PAGE=100
